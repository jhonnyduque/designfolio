# Copy these values into .env.local for local development.
# Never commit real credentials.
DATABASE_URL=mysql://designfolio:replace-me@127.0.0.1:3307/designfolio
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Only this verified email may create the initial administrator account.
# Leave empty until the owner is ready to bootstrap; public sign-up is closed.
BOOTSTRAP_ADMIN_EMAIL=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Designfolio <no-reply@designfolio.local>
