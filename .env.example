# Variables de entorno de Designfolio.
#
# Copia este archivo como `.env.local` y rellena los valores. `.env.local`
# está en .gitignore y nunca se commitea; este ejemplo sí, para que los
# nombres queden documentados.
#
# En producción viven en:
#   hPanel → Websites → designfolio.jhonnyduque.com → Environment variables
#   https://hpanel.hostinger.com/websites/designfolio.jhonnyduque.com/environment-variables
#
# Los nombres son idénticos en los dos entornos a propósito: lo que funciona
# en local tiene que funcionar igual arriba. Ver docs/VARIABLES_ENTORNO.md.


# ---------------------------------------------------------------- Base de datos

# Conexión a MySQL. La usan Drizzle y Better Auth.
# En local, con el contenedor de docker-compose: puerto 3307.
DATABASE_URL=mysql://usuario:contraseña@127.0.0.1:3307/designfolio


# -------------------------------------------------------------- Autenticación

# URL pública del sitio. Better Auth la usa para construir los enlaces de los
# correos y el retorno desde Google. En local, el puerto tiene que coincidir
# con el del servidor de desarrollo o las cookies no se aceptan.
BETTER_AUTH_URL=http://localhost:3000

# Firma las sesiones y la cookie del código de invitación.
# Genera uno propio, no reutilices el de producción:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Acceso con Google. Las dos tienen que estar: con una sola, el proveedor no
# se declara y el botón no aparece en el login.
#
# El cliente OAuth necesita tener autorizada la URI de retorno de cada entorno:
#   http://localhost:3000/api/auth/callback/google
#   https://designfolio.jhonnyduque.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# El correo que recibe el rol de fundador al registrarse. Solo actúa una vez.
BOOTSTRAP_ADMIN_EMAIL=


# --------------------------------------------------------- Correo transaccional

# Envían la verificación de la cuenta y el restablecimiento de contraseña.
# Sin SMTP_USER y SMTP_PASSWORD no sale ningún correo, así que en local no se
# puede completar un registro: la cuenta se queda sin verificar.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# ------------------------------------------------------------- Almacenamiento

# Carpeta donde se guardan avatares y los medios de las obras.
#
# Tiene que apuntar FUERA del proyecto: en Hostinger cada despliegue reemplaza
# la carpeta de la aplicación, así que lo que se guarde dentro desaparece.
#
# En local es opcional. Sin ella, lib/media-storage.ts usa `.media/` en la raíz
# del proyecto —también fuera de public/, para que los dos entornos se
# comporten igual—. Ponla solo si quieres que las subidas sobrevivan a borrar
# la carpeta del proyecto.
#
# Los archivos no se sirven desde public/: lo hace app/media/[...path]/route.ts,
# con soporte de peticiones parciales para que los vídeos se puedan adelantar.
# MEDIA_ROOT=
